# Twofold local development — copy to .env and adjust as needed.
APP_ENV=development
HTTP_ADDR=:8080

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://twofold:twofold@127.0.0.1:5434/twofold?sslmode=disable

# Customer API Ed25519 PKCS8 PEM (dev fixture only — never use in production)
JWT_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIEYvOe71U17PMCCpR2AN2sf9C8oH7X73qbubJj/CkhXy\n-----END PRIVATE KEY-----"
JWT_KID=dev-1
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Auth endpoint rate limits (token bucket burst / refill window)
AUTH_RATE_LIMIT_BURST=5
AUTH_RATE_LIMIT_WINDOW=60s

# Staff / admin API JWT signing material (separate audience — never reuse)
STAFF_JWT_SIGNING_KEY=dev-only-change-me-staff-jwt-signing-key

SHUTDOWN_TIMEOUT=10s
DB_MAX_CONNS=10
DB_MIN_CONNS=1
