# Twofold local development — copy to .env and adjust as needed.
APP_ENV=development
HTTP_ADDR=:8080

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://twofold:twofold@127.0.0.1:5434/twofold?sslmode=disable

# Customer API JWT signing material (replace before any shared deploy)
JWT_SIGNING_KEY=dev-only-change-me-customer-jwt-signing-key

# Staff / admin API JWT signing material (separate audience — never reuse)
STAFF_JWT_SIGNING_KEY=dev-only-change-me-staff-jwt-signing-key

SHUTDOWN_TIMEOUT=10s
DB_MAX_CONNS=10
DB_MIN_CONNS=1
